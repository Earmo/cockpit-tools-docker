# 首次直接运行 start.sh 会生成 .env 和随机密码。
VNC_USERNAME=cockpit
VNC_PASSWORD=

# 空值使用项目专属 Docker 存储卷；也可填写绝对路径或相对本目录的路径。
DATA_DIR=
VNC_WEB_PORT=13001
API_PORT=42991
CONTAINER_NAME=cockpit-tools-vnc
USER_ID=1000
GROUP_ID=1000
TZ=Asia/Singapore

# 可选代理。DOWNLOAD_PROXY 和 BUILD_PROXY 留空时继承 APP_PROXY。
APP_PROXY=
DOWNLOAD_PROXY=
BUILD_PROXY=
# 可选下载加速前缀，例如 https://gh-proxy.com/；元数据仍从官方 API 获取。
DOWNLOAD_PREFIX=
UBUNTU_MIRROR=http://mirrors.aliyun.com/ubuntu
